<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/bg_dark">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:lottie_url="https://assets3.lottiefiles.com/packages/lf20_pw5vbvkq.json"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Try it once."
        android:textColor="@color/white"
        android:textSize="28sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Before day one starts, let's practice the drink verification — point your camera at a glass, then drink from it. No pressure, no stakes."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_tutorial"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💧 Start Practice Drink"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/btn_skip_tutorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Skip — I'll figure it out"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:paddingVertical="12dp" />

</LinearLayout>
