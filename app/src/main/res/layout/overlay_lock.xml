<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Water drop icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_water_drop"
        android:tint="@color/accent_blue"
        android:layout_marginBottom="24dp" />

    <!-- HydroLock label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HYDROLOCK"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="16dp" />

    <!-- Main message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time to drink."
        android:textColor="@color/white"
        android:textSize="32sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="250ml"
        android:textColor="@color/accent_blue"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your phone is locked until you drink."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Drink Now button -->
    <TextView
        android:id="@+id/btn_drink_now"
        android:layout_width="260dp"
        android:layout_height="56dp"
        android:background="@drawable/btn_primary_bg"
        android:gravity="center"
        android:text="💧 Drink Now"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="16dp" />

    <!-- Override -->
    <TextView
        android:id="@+id/btn_override"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can't drink right now"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:paddingVertical="12dp" />

</LinearLayout>
