<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your intake"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How much do you currently drink per day?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Current intake -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_current_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0ml per day"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp" />

        <SeekBar
            android:id="@+id/seekbar_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/text_muted"
            android:thumbTint="@color/text_muted"
            android:layout_marginBottom="32dp" />

        <!-- Goal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_suggested_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_goal_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0ml per day"
            android:textColor="@color/accent_blue"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp" />

        <SeekBar
            android:id="@+id/seekbar_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/accent_blue"
            android:thumbTint="@color/accent_blue"
            android:layout_marginBottom="24dp" />

        <!-- Ramp info -->
        <TextView
            android:id="@+id/tv_ramp_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
