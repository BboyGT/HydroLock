<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HydroLock" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.HydroLock.NoActionBar" parent="Theme.HydroLock">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HydroLock.Lock" parent="Theme.HydroLock.NoActionBar">
        <item name="android:windowBackground">@color/overlay_bg</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
    </style>

    <style name="HydroAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
